# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Trusted key: server only, never in a browser or the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy (HS256) projects: Settings -> API -> JWT Secret. Leave empty on newer
# projects; tokens are then verified with the project's public JWKS.
SUPABASE_JWT_SECRET=

# 64 hex characters. Generate with: python -c "import os;print(os.urandom(32).hex())"
# Encrypts provider and connection secrets. Losing it makes them unreadable.
ENCRYPTION_KEY=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000
