# Copy to backend/.env (never commit the real file).
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Meta app (developers.facebook.com -> your app -> App settings -> Basic) ---
META_APP_ID=
META_APP_SECRET=
# Use the Graph API version your app is configured for, e.g. v24.0.
META_GRAPH_VERSION=v24.0
# Any long random string; paste the same value into the app's WhatsApp webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Fernet key for encrypting business tokens/PINs at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Supabase ---
# "postgres" for real deployments; "memory" keeps data in-process (local demo only).
REPOSITORY_BACKEND=postgres
# Project Settings -> Database -> Connection string (URI). Keep it server-side only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Leave empty to verify user JWTs with the project's JWKS (asymmetric signing keys).
# Only set this if the project still uses the legacy shared HS256 JWT secret.
SUPABASE_JWT_SECRET=

SIGNUP_RATE_LIMIT_PER_MINUTE=10
