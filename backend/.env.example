# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Trusted key: server only, never in a browser or the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy (HS256) projects: Settings -> API -> JWT Secret. Leave empty on newer
# projects; tokens are then verified with the project's public JWKS.
SUPABASE_JWT_SECRET=

# 64 hex characters. Generate with: python -c "import os;print(os.urandom(32).hex())"
# Encrypts provider and connection secrets. Losing it makes them unreadable.
ENCRYPTION_KEY=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Razorpay (use test keys first). Webhook URL: https://<api-host>/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret the web app uses for /v1/internal (wallet charges for WhatsApp messages, events).
# Long and random; the same value goes in the web app's AUTOSHIFT_INTERNAL_SECRET. Empty = switched off.
INTERNAL_SECRET=
# Public address of the web app (invite links: <SITE_URL>/join/<token>)
SITE_URL=https://app.autoshift.example
# First two digits of AutoShift's GSTIN (decides CGST+SGST versus IGST on invoices)
SELLER_STATE_CODE=29
