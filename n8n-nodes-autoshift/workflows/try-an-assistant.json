{
  "name": "AutoShift: try an assistant",
  "nodes": [
    {
      "id": "1",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "Test a reply",
      "type": "n8n-nodes-autoshift.autoShift",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "assistant",
        "operation": "testReply",
        "assistantId": "PASTE_ASSISTANT_ID",
        "message": "What are your opening hours?",
