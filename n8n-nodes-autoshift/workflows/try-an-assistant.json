      },
      "credentials": {
        "autoShiftApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "AutoShift API"
        }
      }
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Test a reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}