{
  "name": "AutoShift: weekly plan and trial check",
  "nodes": [
    {
      "id": "1",
      "name": "Every Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Get subscription",
      "type": "n8n-nodes-autoshift.autoShift",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "subscription",
        "operation": "get"
      },
      "credentials": {
        "autoShiftApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "AutoShift API"
        }
      }
    },
    {
      "id": "3",
      "name": "Trial ends soon?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "trialing",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Remind the team",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every Monday": {
      "main": [
        [
          {
            "node": "Get subscription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get subscription": {
      "main": [
        [
          {
            "node": "Trial ends soon?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trial ends soon?": {
      "main": [
        [
          {
            "node": "Remind the team",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}