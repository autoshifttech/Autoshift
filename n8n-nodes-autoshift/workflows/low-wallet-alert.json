{
  "name": "AutoShift: low wallet alert",
  "nodes": [
    {
      "id": "1",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Get wallet",
      "type": "n8n-nodes-autoshift.autoShift",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "wallet",
        "operation": "balance"
      },
      "credentials": {
        "autoShiftApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "AutoShift API"
        }
      }
    },
    {
      "id": "3",
      "name": "Below ₹500?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.balance_paise }}",
              "rightValue": 50000,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Send your alert here",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        -80
      ],
      "parameters": {}
    },
    {
      "id": "5",
      "name": "Balance is fine",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        80
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Get wallet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get wallet": {
      "main": [
        [
          {
            "node": "Below ₹500?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Below ₹500?": {
      "main": [
        [
          {
            "node": "Send your alert here",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Balance is fine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}