# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

# --- Addresses (DNS A records pointing at this server) ---
API_DOMAIN=api.autoshift.tech
N8N_DOMAIN=n8n.autoshift.tech
TIMEZONE=Asia/Kolkata

# --- n8n: encrypts saved credentials. Make once (openssl rand -hex 32) and never change. ---
N8N_ENCRYPTION_KEY=

# --- Backend: Supabase (Project Settings -> API Keys) ---
SUPABASE_URL=https://zyjmlyknixukfbfvchdi.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty: the project uses the new signing keys, checked through its public JWKS.
SUPABASE_JWT_SECRET=

# Same value as ENCRYPTION_KEY in Vercel.
ENCRYPTION_KEY=

# Shared with the website: put the same value in Vercel as AUTOSHIFT_INTERNAL_SECRET (openssl rand -hex 32).
INTERNAL_SECRET=

SITE_URL=https://www.autoshift.tech
CORS_ORIGINS=https://www.autoshift.tech,https://autoshift.tech,https://autoshift-sigma.vercel.app
MCP_ALLOWED_HOSTS=api.autoshift.tech,api.autoshift.tech:*
# Set before taking payments: first two digits of your GSTIN (29 Karnataka, 33 Tamil Nadu, 27 Maharashtra ...).
# SELLER_STATE_CODE=29

# --- Razorpay (later; test keys first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
