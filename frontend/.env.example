# Copy to frontend/.env.local. Every VITE_ value is bundled into the browser: public values only.
VITE_API_BASE_URL=http://localhost:8000

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Meta app ID and the Embedded Signup configuration ID (Facebook Login for Business -> Configurations)
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_VERSION=v24.0

# Optional public contact details shown on the site
VITE_CONTACT_EMAIL=
